APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret

POSTGRES_DB=semanticfit
POSTGRES_USER=semanticfit
POSTGRES_PASSWORD=semanticfit
DATABASE_URL=postgresql+psycopg://semanticfit:semanticfit@localhost:5432/semanticfit

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semanticfit_products

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

EMBEDDING_BACKEND=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=128
EMBEDDING_USE_FP16=true

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=20
SEARCH_CANDIDATE_COUNT=50
SEARCH_DEFAULT_LIMIT=8
SEARCH_MAX_LIMIT=24

LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20

FEEDBACK_ENABLED=true
AUDIT_ENABLED=true

# Development/demo credentials only. Production refuses the defaults.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_COOKIE_SECURE=false

DATA_DIR=../data
REPORTS_DIR=../reports
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=180
SEARCH_RATE_LIMIT_PER_MINUTE=60
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10
